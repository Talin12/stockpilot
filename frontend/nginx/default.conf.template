# Rendered at container start by the nginx image's envsubst step:
#   BACKEND_URL -> where /api is proxied (compose: http://backend:8000, k8s: the backend Service)
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  server_tokens off;
  # nginx drops inherited add_header directives in any location that sets its own,
  # so the security headers live in a snippet included wherever headers are added.
  include /etc/nginx/security-headers.conf;

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  # Probe target for Docker HEALTHCHECK and Kubernetes liveness/readiness.
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Vite fingerprints asset filenames, so they can be cached forever.
  location /assets/ {
    expires 1y;
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # SPA fallback: unknown paths serve index.html; never cache it so new deploys show up.
  location / {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }

  # Same-origin API proxy. With an Ingress in front, /api is routed straight to the
  # backend Service and never reaches this block; it is used by Compose and port-forwards.
  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }
}
