# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored.
# AWS credentials are NOT configured here: use `aws configure` / AWS_PROFILE.

project            = "stockpilot"
environment        = "dev"
aws_region         = "ap-south-1"
cluster_name       = "stockpilot-eks"
kubernetes_version = "1.35"

vpc_cidr = "10.20.0.0/16"
az_count = 2

node_instance_types = ["t3.medium"]
node_capacity_type  = "ON_DEMAND" # "SPOT" is ~60-70% cheaper but can be interrupted
node_min_size       = 2
node_desired_size   = 3
node_max_size       = 5

# IAM user/role used by GitHub Actions to deploy (gets cluster-admin via EKS access entries)
# cluster_admin_arns = ["arn:aws:iam::123456789012:user/stockpilot-github-deployer"]
