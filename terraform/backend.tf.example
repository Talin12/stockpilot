# Optional remote state. Copy to backend.tf, create the bucket once, then `terraform init -migrate-state`.
#   aws s3api create-bucket --bucket <unique-bucket> --region ap-south-1 \
#     --create-bucket-configuration LocationConstraint=ap-south-1
#   aws s3api put-bucket-versioning --bucket <unique-bucket> --versioning-configuration Status=Enabled
terraform {
  backend "s3" {
    bucket       = "<unique-bucket>"
    key          = "stockpilot/terraform.tfstate"
    region       = "ap-south-1"
    encrypt      = true
    use_lockfile = true # S3-native state locking (Terraform >= 1.10), no DynamoDB table needed
  }
}
